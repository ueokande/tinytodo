{
  "name": "tinytodo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm typecheck && vite build && node scripts/build-sw.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vite": "^7.2.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@biomejs/biome": "2.4.8"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
